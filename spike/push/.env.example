# Copy to .env and fill in. `.env` is gitignored at the repo root. Never commit it.
#
# Make the key pair with:   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: URL Apple can use to contact you about this sender.
VAPID_SUBJECT=mailto:you@example.com
# Any long random string. `send.sh` sends it as a bearer token. Make one with:
#   openssl rand -hex 32
SEND_SECRET=
# Where subscriptions are stored. On Cloud Run this must be under the mounted bucket
# (deploy.sh mounts it at /data) or it is lost every time the instance scales to zero.
DATA_FILE=./data/subscriptions.json
