# Copy to .env and fill in. .env is gitignored — the repo is public.
# The disposable Google Sheet the integration tests write to.
SHEETS_TEST_ID=
# A spare Google Calendar the integration tests create events on.
# Use a NEW calendar, not your personal one — the tests create and delete events.
CALENDAR_TEST_ID=
# The /exec URL of the deployed Apps Script web app — copy it from the Apps Script
# editor after Deploy > New deployment > Web app.
APPS_SCRIPT_EXEC_URL=
# The shared secret the integration tests send as the caller identity. Must match the
# TEST_TOKEN script property set on that deployment (Project Settings > Script Properties).
APPS_SCRIPT_TEST_TOKEN=
